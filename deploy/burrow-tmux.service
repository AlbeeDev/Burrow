[Unit]
# Burrow's persistent tmux server. Runs on the HOST, owned by host systemd, so it lives
# in system.slice: a SIBLING of the burrow-app container's cgroup, not a child. That is
# the whole point: rebuilding/recreating the burrow-app container no longer tears this
# server down, so terminal sessions (and the running `claude` inside them) survive deploys.
#
# terminal.ts talks to this server via the named socket `-L burrow` (see TMUX_SOCKET).
# Install once on the host, then it just stays up across every future Burrow deploy.
Description=Burrow persistent tmux server (survives app-container rebuilds)
After=network.target
# Keep it alive for the box's lifetime; it is cheap (one idle keepalive session).

[Service]
Type=forking
# tmux hands its SERVER environment to every new pane, so anything a session's `claude`
# needs must live here. IS_SANDBOX=1 is the one that bit us: Claude Code refuses
# `--dangerously-skip-permissions` when running as root UNLESS this is set. The old
# nsenter-spawned server inherited it from the container's env; a systemd service starts
# with a clean env, so we must set it explicitly (matches the container: HOME=/root, C.UTF-8).
Environment=IS_SANDBOX=1
Environment=HOME=/root
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
# Start the server with one keepalive session so the tmux daemon never exits on its own
# (Burrow's real sessions come and go; the keepalive keeps the server, and its cgroup, 
# alive with zero projects open). `_keepalive` does not match `burrow_*`, so Burrow's own
# kill guard will never touch it.
ExecStart=/usr/bin/tmux -L burrow new-session -d -s _keepalive sleep infinity
ExecStop=/usr/bin/tmux -L burrow kill-server
Restart=on-failure
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
