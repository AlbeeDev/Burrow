# Shared secret the Burrow app sends on connect. OPTIONAL.
# Leave empty to rely on Tailscale alone (only your Tailnet devices can reach BURROW_BIND).
# Set one for defense-in-depth. Generate with: openssl rand -hex 32
# Note: binding to a public address (0.0.0.0) with no token is refused at startup.
BURROW_TOKEN=

# Address to bind the WebSocket server to. Loopback by default: Burrow hands a browser a shell on
# this machine, so it does not reach the network unless you say so.
#
# To open it to other devices, put it behind something that already handles identity, Tailscale
# (see Settings → Addons), WireGuard, or a reverse proxy, and bind to that interface's address.
# Binding to 0.0.0.0 with no BURROW_TOKEN is refused at startup.
BURROW_BIND=127.0.0.1

# Port the gateway listens on.
BURROW_PORT=8317

# Root directory whose subfolders become "projects". The master terminal opens here.
BURROW_PROJECTS_ROOT=/root

# Claude mode auth. The gateway runs Claude Code headlessly, which needs its own
# credentials (independent of any interactive login). Provide ONE of:
#   - a long-lived token from `claude setup-token`  → set it here
#   - an Anthropic API key                          → set ANTHROPIC_API_KEY instead
# Without this, Terminal mode still works; Claude mode returns an auth error.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
