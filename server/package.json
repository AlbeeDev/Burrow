{
  "name": "burrow-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Burrow gateway \u2014 WebSocket bridge between the Burrow app and a VPS shell (Phase 1: terminal mode).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness:bubble": "tsx scripts/bubble-harness.ts",
    "harness:wake": "tsx scripts/wake-harness.ts",
    "harness": "npm run harness:bubble && npm run harness:wake",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.212",
    "@lydell/node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
